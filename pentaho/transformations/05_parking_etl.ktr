      <schema_name/>
    </partitioning>
    <connection>smart_city_platform</connection>
    <sql>SELECT
    record_id,
    source_record_id,
    source_data->>'Parking_Spot_ID' AS parking_spot_id,
    NULLIF(source_data->>'Timestamp', '')::TIMESTAMPTZ AS timestamp,
    source_data->>'Occupancy_Status' AS occupancy_status,
    NULLIF(source_data->>'Occupancy_Rate', '')::NUMERIC AS occupancy_rate,
    source_data->>'Vehicle_Type' AS vehicle_type,
    source_data->>'User_Type' AS user_type,
    NULLIF(source_data->>'Entry_Time', '') AS entry_time,
    NULLIF(source_data->>'Exit_Time', '') AS exit_time,
    NULLIF(source_data->>'Parking_Duration', '')::NUMERIC AS parking_duration,
    NULLIF(source_data->>'Payment_Amount', '')::NUMERIC AS payment_amount,
    source_data->>'Payment_Status' AS payment_status,
    source_data->>'Reserved_Status' AS reserved_status,
    source_data->>'Parking_Violation' AS parking_violation,
    NULLIF(source_data->>'Electric_Vehicle', '')::BOOLEAN AS electric_vehicle,
    NULLIF(source_data->>'Weather_Temperature', '')::NUMERIC AS weather_temperature,
    NULLIF(source_data->>'Weather_Precipitation', '')::NUMERIC AS weather_precipitation,
    source_data->>'Nearby_Traffic_Level' AS nearby_traffic_level
FROM staging.parking s
WHERE NOT EXISTS (
    SELECT 1
    FROM warehouse.parking w
    WHERE w.record_id = s.record_id
);</sql>
